---
interface Props {
  notes: string[];
}
const { notes } = Astro.props;
---

{/* Köşeli ve çerçevesiz: sitenin geri kalanı keskin köşeliyken bu haplar
    rounded-full ile jenerik bir bileşen gibi duruyordu. */}
{notes.length > 0 && (
  <ul class="font-sans flex flex-wrap gap-x-2 gap-y-2 list-none p-0 m-0">
    {notes.map((n) => (
      <li class="border border-[var(--color-line)] px-2.5 py-1 text-[13px] leading-snug text-[var(--color-ink)]">
        {n}
      </li>
    ))}
  </ul>
)}
