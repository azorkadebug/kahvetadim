---
import BrewIcon from './BrewIcon.astro';
import GrinderIcon from './GrinderIcon.astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { formatDate, processLabel, methodLabel, type Choice } from '../i18n/utils';

interface Props {
  coffee: {
    roaster: string;
    origin: string;
    region?: string;
    process: Choice;
    roastDate?: Date;
    altitude?: string;
    roastLevel?: string;
    roastMachine?: string;
  };
  brew: {
    method: Choice;
    grindSize?: string;
    ratio?: string;
    time?: string;
    waterTemp?: string;
    bloom?: string;
    pour?: string;
  };
  overall: number;
  locale?: Lang;
}

const { coffee, brew, overall, locale = defaultLang } = Astro.props;
const t = useTranslations(locale);

const fmt = (d?: Date) =>
  d ? formatDate(locale, d, { day: 'numeric', month: 'short', year: 'numeric' }) : null;

/** num: sayısal alan → tabular-nums ile hizalanır. */
type Item = { label: string; value: string; num?: boolean };

const items: Item[] = [
  { label: t('data.roaster'), value: coffee.roaster },
  { label: t('data.origin'), value: [coffee.origin, coffee.region].filter(Boolean).join(' · ') },
  { label: t('data.process'), value: processLabel(locale, coffee.process) },
];
if (coffee.altitude) items.push({ label: t('data.altitude'), value: coffee.altitude, num: true });
if (coffee.roastLevel) items.push({ label: t('data.roastLevel'), value: coffee.roastLevel });
if (coffee.roastMachine) items.push({ label: t('data.roastMachine'), value: coffee.roastMachine });
if (brew.grindSize) items.push({ label: t('data.grind'), value: brew.grindSize, num: true });
if (brew.ratio) items.push({ label: t('data.ratio'), value: brew.ratio, num: true });
if (brew.time) items.push({ label: t('data.time'), value: brew.time, num: true });
if (brew.waterTemp) items.push({ label: t('data.waterTemp'), value: brew.waterTemp, num: true });
if (brew.bloom) items.push({ label: t('data.bloom'), value: brew.bloom, num: true });
if (brew.pour) items.push({ label: t('data.pour'), value: brew.pour, num: true });
if (coffee.roastDate) items.push({ label: t('data.roasted'), value: fmt(coffee.roastDate)!, num: true });
---

{/* Ölçüm paneli: sitenin kendine ait tek dili. Değerler gövde metniyle
    yarışacak boyutta, etiketler geride; vurgu rengi yalnızca burada. */}
<section class="font-sans border-y border-[var(--color-line)] bg-[var(--color-bg)]">
  <div class="flex flex-col lg:flex-row lg:items-stretch">
    {/* demleme yöntemi — el çizimi ikon, sitenin en özgün grafik varlığı */}
    <div class="flex items-center gap-4 px-1 py-6 lg:pr-8 lg:border-r border-[var(--color-line)] lg:min-w-[15rem]">
      <BrewIcon method={brew.method.kind} size={56} class="text-[var(--color-accent)] shrink-0" />
      <div>
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)]">{t('data.brew')}</div>
        <div class="mt-1 text-xl leading-tight text-[var(--color-ink)]">{methodLabel(locale, brew.method)}</div>
      </div>
    </div>

    <ul class="flex-1 grid list-none m-0 p-0 grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-5 px-1 lg:px-8 pb-6 lg:py-6 border-t lg:border-t-0 border-[var(--color-line)] pt-6 lg:pt-6">
      {items.map(({ label, value, num }) => (
        <li>
          <span class="block text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)]">{label}</span>
          <span class={`block mt-1 text-xl leading-tight text-[var(--color-ink)] ${num ? 'tnum' : ''}`}>
            {label === t('data.grind') ? (
              <span class="inline-flex items-center gap-2">
                <GrinderIcon size={20} class="text-[var(--color-accent)] shrink-0" />
                {value}
              </span>
            ) : (
              value
            )}
          </span>
        </li>
      ))}
    </ul>

    {/* puan: sayfanın ikinci büyük ölçek anı */}
    <div class="flex items-baseline gap-4 lg:flex-col lg:items-end lg:justify-center lg:gap-0 px-1 lg:pl-8 py-6 border-t lg:border-t-0 lg:border-l border-[var(--color-line)] lg:min-w-[10rem]">
      <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-soft)] lg:order-2 lg:mt-1">
        {t('data.score')}
      </div>
      <div class="font-serif tnum text-6xl lg:text-7xl leading-[0.85] text-[var(--color-accent)] lg:order-1">
        {overall}<span class="font-sans text-xs tracking-wide text-[var(--color-ink-soft)] align-super">/100</span>
      </div>
    </div>
  </div>
</section>
