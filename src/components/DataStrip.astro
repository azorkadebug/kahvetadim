---
import BrewIcon from './BrewIcon.astro';
import GrinderIcon from './GrinderIcon.astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { formatDate, processLabel, methodLabel, type Choice } from '../i18n/utils';

interface Props {
  coffee: {
    roaster: string;
    origin: string;
    region?: string;
    process: Choice;
    roastDate?: Date;
    altitude?: string;
    roastLevel?: string;
    roastMachine?: string;
  };
  brew: {
    method: Choice;
    grindSize?: string;
    ratio?: string;
    time?: string;
    waterTemp?: string;
    bloom?: string;
    pour?: string;
  };
  overall: number;
  locale?: Lang;
}

const { coffee, brew, overall, locale = defaultLang } = Astro.props;
const t = useTranslations(locale);

const fmt = (d?: Date) =>
  d ? formatDate(locale, d, { day: 'numeric', month: 'short', year: 'numeric' }) : null;

/** num: sayısal alan → tabular-nums ile hizalanır. */
type Item = { label: string; value: string; num?: boolean };

const items: Item[] = [
  { label: t('data.roaster'), value: coffee.roaster },
  { label: t('data.origin'), value: [coffee.origin, coffee.region].filter(Boolean).join(' · ') },
  { label: t('data.process'), value: processLabel(locale, coffee.process) },
];
if (coffee.altitude) items.push({ label: t('data.altitude'), value: coffee.altitude, num: true });
if (coffee.roastLevel) items.push({ label: t('data.roastLevel'), value: coffee.roastLevel });
if (coffee.roastMachine) items.push({ label: t('data.roastMachine'), value: coffee.roastMachine });
if (brew.grindSize) items.push({ label: t('data.grind'), value: brew.grindSize, num: true });
if (brew.ratio) items.push({ label: t('data.ratio'), value: brew.ratio, num: true });
if (brew.time) items.push({ label: t('data.time'), value: brew.time, num: true });
if (brew.waterTemp) items.push({ label: t('data.waterTemp'), value: brew.waterTemp, num: true });
if (brew.bloom) items.push({ label: t('data.bloom'), value: brew.bloom, num: true });
if (brew.pour) items.push({ label: t('data.pour'), value: brew.pour, num: true });
if (coffee.roastDate) items.push({ label: t('data.roasted'), value: fmt(coffee.roastDate)!, num: true });

/* Sütun sayısı alan sayısına göre: son satırda tek hücre kalmasın
   (7 alan 3/3/1, 10 alan 3/3/3/1 diziliyordu). Mobilde 2 sütun; tek sayıda
   alan varsa son hücre iki sütuna yayılır. */
const n = items.length;
const wideCols = n % 3 === 1 ? 'sm:grid-cols-4' : 'sm:grid-cols-3';
const lastSpan = n % 2 === 1 ? 'max-sm:col-span-2' : '';
---

{/* Ölçüm paneli: sitenin kendine ait tek dili. Değerler gövde metniyle
    yarışacak boyutta, etiketler geride.
    Düzen: mobilde demleme ve puan üstte tek satırda iki uçta, ızgara altta
    (önceden üç ayrı tam genişlik bant, şerit bir ekran boyu tutuyordu);
    lg'de demleme | ızgara | puan, üçü de üste hizalı. */}
<section class="font-sans border-y border-[var(--color-line)] bg-[var(--color-bg)] break-inside-avoid">
  <div class="grid grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[auto_minmax(0,1fr)_auto] items-start">
    {/* demleme yöntemi — el çizimi ikon, sitenin en özgün grafik varlığı */}
    <div class="flex items-center lg:items-start gap-4 py-5 lg:py-6 lg:pr-8 lg:border-r border-[var(--color-line)] lg:self-stretch">
      <BrewIcon method={brew.method.kind} size={56} class="text-[var(--color-accent)] shrink-0" />
      <div>
        <div class="etiket">{t('data.brew')}</div>
        <div class="mt-1 text-xl leading-tight text-[var(--color-ink)]">{methodLabel(locale, brew.method)}</div>
      </div>
    </div>

    <ul class={`col-span-2 lg:col-span-1 lg:order-none order-last grid list-none m-0 p-0 grid-cols-2 ${wideCols} gap-x-6 lg:gap-x-8 gap-y-5 lg:px-8 py-6 border-t lg:border-t-0 border-[var(--color-line)]`}>
      {items.map(({ label, value, num }, i) => (
        <li class={`min-w-0 ${i === n - 1 ? lastSpan : ''}`}>
          <span class="etiket block">{label}</span>
          <span class={`block mt-1 text-xl leading-tight text-[var(--color-ink)] [overflow-wrap:anywhere] ${num ? 'tnum' : ''}`}>
            {label === t('data.grind') ? (
              <span class="flex items-start gap-2">
                <GrinderIcon size={20} class="text-[var(--color-accent)] shrink-0 mt-0.5" />
                <span class="min-w-0">{value}</span>
              </span>
            ) : (
              value
            )}
          </span>
        </li>
      ))}
    </ul>

    {/* puan: sayfanın ikinci büyük ölçek anı */}
    <div class="flex flex-col items-end justify-center lg:justify-start py-5 lg:py-6 lg:pl-8 lg:border-l border-[var(--color-line)] lg:self-stretch">
      <div class="font-serif text-6xl lg:text-7xl leading-[0.85] text-[var(--color-accent)]">
        {overall}<span class="font-sans text-xs tracking-wide text-[var(--color-ink-soft)] align-super">/100</span>
      </div>
      <div class="etiket mt-1.5">{t('data.score')}</div>
    </div>
  </div>
</section>
