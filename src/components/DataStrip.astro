---
import BrewIcon from './BrewIcon.astro';
import GrinderIcon from './GrinderIcon.astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { formatDate, processLabel, methodLabel, type Choice } from '../i18n/utils';

interface Props {
  coffee: {
    roaster: string;
    origin: string;
    region?: string;
    process: Choice;
    roastDate?: Date;
    altitude?: string;
    roastLevel?: string;
    roastMachine?: string;
  };
  brew: {
    method: Choice;
    grindSize?: string;
    ratio?: string;
    time?: string;
    waterTemp?: string;
    bloom?: string;
    pour?: string;
  };
  overall: number;
  locale?: Lang;
}

const { coffee, brew, overall, locale = defaultLang } = Astro.props;
const t = useTranslations(locale);

const fmt = (d?: Date) =>
  d ? formatDate(locale, d, { day: 'numeric', month: 'short', year: 'numeric' }) : null;

/** num: sayısal alan → tabular-nums ile hizalanır. */
type Item = { label: string; value: string; num?: boolean };

const items: Item[] = [
  { label: t('data.roaster'), value: coffee.roaster },
  { label: t('data.origin'), value: [coffee.origin, coffee.region].filter(Boolean).join(' · ') },
  { label: t('data.process'), value: processLabel(locale, coffee.process) },
];
if (coffee.altitude) items.push({ label: t('data.altitude'), value: coffee.altitude, num: true });
if (coffee.roastLevel) items.push({ label: t('data.roastLevel'), value: coffee.roastLevel });
if (coffee.roastMachine) items.push({ label: t('data.roastMachine'), value: coffee.roastMachine });
if (brew.grindSize) items.push({ label: t('data.grind'), value: brew.grindSize, num: true });
if (brew.ratio) items.push({ label: t('data.ratio'), value: brew.ratio, num: true });
if (brew.time) items.push({ label: t('data.time'), value: brew.time, num: true });
if (brew.waterTemp) items.push({ label: t('data.waterTemp'), value: brew.waterTemp, num: true });
if (brew.bloom) items.push({ label: t('data.bloom'), value: brew.bloom, num: true });
if (brew.pour) items.push({ label: t('data.pour'), value: brew.pour, num: true });
if (coffee.roastDate) items.push({ label: t('data.roasted'), value: fmt(coffee.roastDate)!, num: true });

/* Sütun sayısı alan sayısına göre: son satırda tek hücre kalmasın
   (7 alan 3/3/1, 10 alan 3/3/3/1 diziliyordu). Form çerçeveli olduğu için
   son satırda boş hücre de kalmamalı: son alan kalan sütunlara yayılır.
   Mobilde 2 sütun. */
const n = items.length;
const cols = n % 3 === 1 ? 4 : 3;
const wideCols = cols === 4 ? 'sm:grid-cols-4' : 'sm:grid-cols-3';
const rem = n % cols;
const smSpan = rem ? ({ 2: 'sm:col-span-2', 3: 'sm:col-span-3' } as Record<number, string>)[cols - rem + 1] ?? '' : '';
const lastSpan = `${n % 2 === 1 ? 'max-sm:col-span-2' : ''} ${smSpan}`;
---

{/* Ölçüm paneli = daktiloyla doldurulmuş cupping formu: etiket ve değer
    mono, hücreler mürekkep çerçeveli. Sitenin kalıbı kırdığı tek yer.
    (El yazısı değerler 2026-09-25'te denendi, rahatsız etti, çıkarıldı.)
    Puan: piksel rakamlı, sert gölgeli damga (Çakıl'ın dili).
    Düzen: mobilde demleme ve puan üstte iki uçta, form altta;
    lg'de demleme | form | puan. */}
<section class="font-sans py-6 bg-[var(--color-bg)] break-inside-avoid">
  <div class="grid grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-y-6">
    {/* demleme yöntemi — el çizimi ikon, sitenin en özgün grafik varlığı */}
    <div class="flex items-center lg:items-start gap-4 lg:pr-8">
      <BrewIcon method={brew.method.kind} size={56} class="text-[var(--color-accent)] shrink-0" />
      <div>
        <div class="etiket">{t('data.brew')}</div>
        <div class="mt-1 text-lg leading-snug text-[var(--color-ink)]">{methodLabel(locale, brew.method)}</div>
      </div>
    </div>

    <ul class={`col-span-2 lg:col-span-1 lg:order-none order-last grid list-none m-0 p-0 grid-cols-2 ${wideCols} border-l-[1.5px] border-t-[1.5px] border-[var(--color-ink)]`}>
      {items.map(({ label, value }, i) => (
        <li class={`min-w-0 px-3 pt-2 pb-2.5 border-r-[1.5px] border-b-[1.5px] border-[var(--color-ink)] ${i === n - 1 ? lastSpan : ''}`}>
          <span class="etiket block">{label}</span>
          <span class="block mt-1 text-lg leading-snug text-[var(--color-ink)] [overflow-wrap:anywhere]">
            {label === t('data.grind') ? (
              <span class="flex items-start gap-2">
                <GrinderIcon size={20} class="text-[var(--color-accent)] shrink-0 mt-0.5" />
                <span class="min-w-0">{value}</span>
              </span>
            ) : (
              value
            )}
          </span>
        </li>
      ))}
    </ul>

    {/* puan: piksel rakamlı damga */}
    <div class="flex flex-col items-end lg:pl-8">
      <div class="flex items-start gap-1 border-[3px] border-[var(--color-accent)] bg-[var(--color-bg)] px-4 pt-3 pb-2 shadow-[5px_5px_0_var(--color-ink)]">
        <span class="puan text-[56px] lg:text-[72px] leading-[0.85] text-[var(--color-accent)]">{overall}</span>
        <span class="text-xs text-[var(--color-ink-soft)]">/100</span>
      </div>
      <div class="etiket mt-3">{t('data.score')}</div>
    </div>
  </div>
</section>
