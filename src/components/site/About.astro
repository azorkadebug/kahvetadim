---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../SectionLabel.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDate, localizePath, tastingLang, tastingSlug, tastingUrl } from '../../i18n/utils';

interface Props {
  locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// TR içeriği 'hakkinda', EN içeriği 'about' girdisinde tutuluyor.
const entryId = locale === 'en' ? 'about' : 'hakkinda';
const entry = await getEntry('sayfalar', entryId);
if (!entry) throw new Error(`Hakkında sayfa içeriği bulunamadı: ${entryId}`);
const { Content } = await render(entry);

// Sağdaki sütun: denetimde burası ~380×400px boş "artık alan" olarak işaretlendi.
const all = await getCollection('tadimlar', (e) => tastingLang(e.id) === locale);
const latest = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const otherLang: Lang = locale === 'tr' ? 'en' : 'tr';
const altUrl = localizePath(otherLang, '/hakkinda/');
---

<BaseLayout
  title={`${entry.data.title} — ${t('site.name')}`}
  description={t('about.description')}
  locale={locale}
  altUrl={altUrl}
>
  <section class="py-8 md:py-16 grid lg:grid-cols-[minmax(0,38rem)_1fr] gap-x-16 gap-y-12 items-start">
    {/* Dar ekran: çizim en üstte, metnin hemen üstünde. Geniş ekranda
        sağ sütundaki kopya görünür, bu gizlenir.
        Çizimlerin iki ölçek katmanı var: metne EŞLİK EDEN çizimler
        96/128/160 (arşiv başlığı, bu sayfa), sayfanın KONUSU olan çizim
        192/224/288 (404). Önceden altı ayrı boy vardı, sistem yoktu. */}
    <img
      src="/cakil-degirmen.png"
      alt={t('about.illustrationAlt')}
      width="56"
      height="80"
      class="order-1 lg:hidden w-[112px] h-auto [image-rendering:pixelated]"
    />

    <div class="order-2 lg:order-1">
      {entry.data.kicker && (
        <p class="etiket">{entry.data.kicker}</p>
      )}
      <h1 class="mt-4 font-serif text-4xl sm:text-5xl leading-tight">{entry.data.title}</h1>
      <div class="mt-5 max-w-[38rem] font-serif text-lg leading-[1.75] text-[var(--color-ink)] [&>p]:mt-5 [&>p:first-child]:mt-0 [&>p]:[text-wrap:pretty]">
        <Content />
      </div>
    </div>

    {/* `lg:sticky lg:top-8` buradan kaldırıldı: sağ sütun ızgara satırının en
        uzun öğesi olduğu için yapışacak yol kalmıyordu (ölçüldü: yapışması
        gereken yerde t=-122). Sayfanın toplam kaydırma yolu da (379px) zaten
        yetmiyor. Tadım sayfasında aynı sınıf çalışıyor, orası öyle kaldı. */}
    <aside class="order-3 lg:order-2">
      {/* Çakıl değirmeni çeviriyor: sağ sütunun başında, listenin üstünde.
          Dar ekranda yukarıdaki kopya görünüyor, bu gizli. */}
      <img
        src="/cakil-degirmen.png"
        alt=""
        aria-hidden="true"
        width="56"
        height="80"
        class="hidden lg:block w-[168px] h-auto [image-rendering:pixelated]"
      />

      {latest.length > 0 && (
        <div class="mt-10">
        <SectionLabel as="h2">{t('home.latest')}</SectionLabel>
        <ul class="mt-5 space-y-4 list-none p-0 m-0">
          {latest.map((e) => {
            const d = e.data;
            return (
              <li class="flex items-baseline gap-3">
                <span class="font-serif text-lg text-[var(--color-accent-deep)] w-8 shrink-0">{d.rating.overall}</span>
                <span>
                  <a
                    href={tastingUrl(locale, tastingSlug(e.id))}
                    class="baslik-link font-serif leading-snug"
                  >{d.title}</a>
                  <span class="block font-sans text-xs text-[var(--color-ink-soft)]">
                    {formatDate(locale, d.date, { day: 'numeric', month: 'short', year: 'numeric' })} · {d.coffee.roaster}
                  </span>
                </span>
              </li>
            );
          })}
        </ul>
        </div>
      )}
    </aside>
  </section>
</BaseLayout>
