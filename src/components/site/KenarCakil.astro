---
/* Sol kenarda koşan Çakıl.
   - Dikey konumu okuma ilerlemesini gösterir: başta yukarıda, sonda aşağıda.
   - Kaydırırken iki karelik koşu döngüsü işler (tek sprite sayfası,
     background-position ile; iki ayrı <img> yerine tek istek).
   - Sprite yana bakıyor; kaydırma yönüne göre 90° döndürülüyor, böylece
     aşağı inerken aşağı, yukarı çıkarken yukarı koşuyor. Piksel sanatı
     tam 90°'de bozulmaz (ara piksel hesaplanmaz).
   - Kaydırma 300 ms durunca koşu solar, Çakıl fincana atlar: havadaki
     kare yukarıdan düşer (ease-in), fincana değince ikinci kareye geçer
     ve küçük bir sıçrama ile oturur.
   - Fincandayken kaydırma yeniden başlarsa önce fırlama karesi oynar
     (fincandan çıkış → havada), sonra koşuya döner.
   - Sayfa açıldığında hiç görünmez: ilk kaydırmayla koşarak girer.
     Önceden fincanın içinde başlıyordu, oradan koşuya geçmesi tuhaftı.
   - Yalnız 1280px üstünde (altında sol boşluk yok) ve hareket azaltma
     kapalıyken görünür. */
---

{/* Dar ekran: üstte ilerleme çizgisi, Çakıl çizginin üstünde koşuyor.
    Geniş ekrandaki sol kenar sürümü ayrı; ikisi aynı JS durumunu paylaşır. */}
<div id="ustCakil" class="ust-cakil" aria-hidden="true">
  <span class="ust-cakil-cizgi"></span>
  <span class="ust-cakil-kopek"></span>
</div>

<div id="kenarCakil" class="kenar-cakil" aria-hidden="true">
  <div class="kenar-cakil-kosu"></div>
  <div class="kenar-cakil-mola"></div>
  <div class="kenar-cakil-cikis"></div>
</div>

<style>
  .ust-cakil { display: none; }

  @media (max-width: 1279px) and (prefers-reduced-motion: no-preference) {
    .ust-cakil {
      display: block;
      position: fixed;
      top: env(safe-area-inset-top, 0px);
      left: 0;
      right: 0;
      /* Çizgi şeridin dibinde; üstteki boşluk köpeğe yer açıyor, yoksa
         ekranın dışında kalıyor. */
      height: 34px;
      pointer-events: none;
      z-index: 20;
    }

    .ust-cakil-cizgi {
      position: absolute;
      bottom: 0;
      left: 0;
      display: block;
      height: 2px;
      width: var(--x, 0%);
      background: var(--color-accent);
      transition: width 120ms linear;
    }

    /* Köpek çizginin üstünde durur; sola yarı genişlik kaydırılır ki
       ucu tam ilerleme noktasına denk gelsin. */
    .ust-cakil-kopek {
      position: absolute;
      bottom: 2px;
      left: var(--x, 0%);
      width: 34px;
      height: 23px;
      margin-left: -30px;
      background-image: url('/cakil-kosu.png');
      background-size: 200% 100%;
      background-repeat: no-repeat;
      image-rendering: pixelated;
      transition: left 120ms linear;
    }

    #ustCakil[data-durum='kosuyor'] .ust-cakil-kopek {
      animation: kenar-kosu 300ms steps(1) infinite;
    }

    /* Durunca fincanın içindeki kare (sprite'ın ikinci karesi). */
    #ustCakil[data-durum='mola'] .ust-cakil-kopek,
    #ustCakil[data-durum='cikis'] .ust-cakil-kopek {
      width: 16px;
      height: 31px;
      margin-left: -16px;
      background-image: url('/cakil-atlama.png');
      background-position: 100% 0%;
    }

    #ustCakil[data-durum='yok'] .ust-cakil-kopek { opacity: 0; }
  }

  .kenar-cakil { display: none; }

  @media (min-width: 1280px) and (prefers-reduced-motion: no-preference) {
    .kenar-cakil {
      display: grid;
      position: fixed;
      /* İçerik 64rem ve ortalanmış; sprite sol boşluğa oturuyor. */
      left: calc((100vw - 64rem) / 2 - 6.5rem);
      top: 0;
      width: 5.5rem;
      height: 5.5rem;
      transform: translateY(var(--y, 25vh));
      transition: transform 280ms ease-out;
      pointer-events: none;
      z-index: 5;
    }

    .kenar-cakil-kosu,
    .kenar-cakil-mola,
    .kenar-cakil-cikis {
      grid-area: 1 / 1;
      transition: opacity 120ms ease-out;
    }

    /* Koşu karesi döndüğü için kutunun ortasında durmalı; alta
       hizalanırsa 90°'de üstten taşıyor. */
    .kenar-cakil-kosu { align-self: center; justify-self: center; }
    .kenar-cakil-mola { align-self: end; }

    /* Sprite sayfası: 186x64, iki kare yan yana. */
    .kenar-cakil-kosu {
      width: 5.5rem;
      height: 3.8rem;
      background-image: url('/cakil-kosu.png');
      background-size: 200% 100%;
      background-repeat: no-repeat;
      image-rendering: pixelated;
      animation: kenar-kosu 300ms steps(1) infinite;
      transform: rotate(var(--yon, 90deg));
      transform-origin: 50% 50%;
      opacity: 0;
    }

    /* Atlayış sayfası: 90x86, iki kare yan yana. */
    .kenar-cakil-mola {
      width: 2.9rem;
      height: 5.5rem;
      justify-self: center;
      background-image: url('/cakil-atlama.png');
      background-size: 200% 100%;
      background-repeat: no-repeat;
      image-rendering: pixelated;
      opacity: 0;
    }

    .kenar-cakil[data-durum='kosuyor'] .kenar-cakil-kosu { opacity: 1; }

    /* Fırlama sayfası: 100x79, iki kare yan yana. */
    .kenar-cakil-cikis {
      width: 3.2rem;
      height: 5.1rem;
      align-self: end;
      justify-self: center;
      background-image: url('/cakil-cikis.png');
      background-size: 200% 100%;
      background-repeat: no-repeat;
      image-rendering: pixelated;
      opacity: 0;
    }

    .kenar-cakil[data-durum='cikis'] .kenar-cakil-cikis {
      opacity: 1;
      animation: kenar-firla 380ms cubic-bezier(0.2, 0.7, 0.4, 1) forwards;
    }

    .kenar-cakil[data-durum='mola'] .kenar-cakil-mola {
      opacity: 1;
      animation: kenar-atla 520ms cubic-bezier(0.34, 0, 0.62, 1) forwards;
    }
    /* 'yok': sayfa henüz kaydırılmadı, ikisi de gizli. */
  }

  /* Kare değişimleri medya sorgularının DIŞINDA tanımlı olmalı: bir
     @keyframes yalnız içinde bulunduğu sorgu eşleştiğinde tanımlı
     sayılıyor, dar ekranda koşu donuk kalıyordu. */
  /* Havadaki kare yukarıdan düşer, fincana değdiği anda ikinci kareye
     geçer, sonra kısa bir oturma sıçraması. Kare değişimi keskin
     (yüzdeler bitişik), düşüş yumuşak (transform). */
  @keyframes kenar-atla {
    0% {
      background-position: 0% 0%;
      transform: translateY(-1.6rem) scaleY(1.04);
    }
    54% {
      background-position: 0% 0%;
      transform: translateY(0) scaleY(1);
    }
    55% {
      background-position: 100% 0%;
      transform: translateY(0.18rem) scaleY(0.94);
    }
    72% {
      background-position: 100% 0%;
      transform: translateY(-0.12rem) scaleY(1.02);
    }
    100% {
      background-position: 100% 0%;
      transform: translateY(0) scaleY(1);
    }
  }

  /* Fincandan fırlayış: ilk kare sıçrama anı, ikincisi havada; hareket
     yukarı doğru yavaşlayarak (ease-out). */
  @keyframes kenar-firla {
    0% {
      background-position: 0% 0%;
      transform: translateY(0.2rem) scaleY(0.95);
    }
    45% {
      background-position: 0% 0%;
      transform: translateY(-0.5rem) scaleY(1.03);
    }
    46%, 100% {
      background-position: 100% 0%;
      transform: translateY(-1.5rem) scaleY(1);
    }
  }

  @keyframes kenar-kosu {
    0%   { background-position: 0% 0%; }
    50%  { background-position: 100% 0%; }
    100% { background-position: 0% 0%; }
  }
</style>

<script>
  const kutu = document.getElementById('kenarCakil');
  const ust = document.getElementById('ustCakil');
  if (kutu) {
    let zamanlayici = 0;

    const yerlestir = () => {
      const belge = document.documentElement;
      const kaydirilabilir = belge.scrollHeight - window.innerHeight;
      const oran = kaydirilabilir > 0 ? Math.min(1, Math.max(0, window.scrollY / kaydirilabilir)) : 0;
      // Ekranın %16'sı ile %70'i arasında gezinir: üstte başlığa,
      // altta altbilgiye çarpmaz.
      kutu.style.setProperty('--y', `${16 + oran * 54}vh`);
      if (ust) ust.style.setProperty('--x', `${(oran * 100).toFixed(1)}%`);
    };

    const mola = kutu.querySelector('.kenar-cakil-mola');
    const cikis = kutu.querySelector('.kenar-cakil-cikis');
    let cikisZamani = 0;
    let sonY = window.scrollY;

    const animasyonuSifirla = (el) => {
      if (!el) return;
      el.style.animation = 'none';
      void el.offsetWidth;
      el.style.animation = '';
    };

    const kaydiriliyor = () => {
      const simdi = window.scrollY;
      if (simdi !== sonY) {
        // Aşağı inerken burun aşağı, yukarı çıkarken burun yukarı.
        kutu.style.setProperty('--yon', simdi > sonY ? '90deg' : '-90deg');
        sonY = simdi;
      }
      if (kutu.dataset.durum === 'mola') {
        // Fincandan çıkmadan koşamaz: önce fırlama oynar.
        animasyonuSifirla(cikis);
        kutu.dataset.durum = 'cikis';
        if (ust) ust.dataset.durum = 'cikis';
        clearTimeout(cikisZamani);
        cikisZamani = window.setTimeout(() => {
          if (kutu.dataset.durum === 'cikis') {
            kutu.dataset.durum = 'kosuyor';
            if (ust) ust.dataset.durum = 'kosuyor';
          }
        }, 340);
      } else if (kutu.dataset.durum !== 'cikis') {
        kutu.dataset.durum = 'kosuyor';
        if (ust) ust.dataset.durum = 'kosuyor';
      }
      yerlestir();
      clearTimeout(zamanlayici);
      zamanlayici = window.setTimeout(() => {
        // Atlayış her duruşta baştan oynasın.
        animasyonuSifirla(mola);
        kutu.dataset.durum = 'mola';
        if (ust) ust.dataset.durum = 'mola';
      }, 340);
    };

    // Açılışta görünmez: ilk kaydırmada koşarak giriyor.
    kutu.dataset.durum = 'yok';
    if (ust) ust.dataset.durum = 'yok';
    yerlestir();
    window.addEventListener('scroll', kaydiriliyor, { passive: true });
    window.addEventListener('resize', yerlestir);
  }
</script>
