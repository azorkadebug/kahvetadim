---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KenarCakil from './KenarCakil.astro';
import DataStrip from '../DataStrip.astro';
import FlavorChips from '../FlavorChips.astro';
import SectionLabel from '../SectionLabel.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDate, localizePath, processLabel } from '../../i18n/utils';

interface Props {
  entry: CollectionEntry<'tadimlar'>;
  locale: Lang;
  /** Diğer dildeki eş tadımın yolu (yoksa null → o dilin ana sayfasına düşer). */
  altUrl?: string | null;
}
const { entry, locale, altUrl = null } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const d = entry.data;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const productName = [d.coffee.roaster, d.coffee.origin, d.coffee.region].filter(Boolean).join(' — ');
// Şemada ham kapak PNG'sine (2-6 MB) değil, build'in ürettiği hazır OG
// görseline işaret et — crawler'lar bu alanı çekiyor.
const coverURL = new URL(`/og/${entry.id}.jpg`, Astro.site).toString();
const authorUrl = new URL(localizePath(locale, '/hakkinda/'), Astro.site).toString();

const reviewLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  inLanguage: locale,
  itemReviewed: {
    '@type': 'Product',
    name: productName || d.title,
    category: 'Coffee',
    brand: { '@type': 'Brand', name: d.coffee.roaster },
    ...(coverURL ? { image: coverURL } : {}),
    ...(d.coffee.farm || d.coffee.variety || d.coffee.process
      ? {
          additionalProperty: [
            d.coffee.farm && { '@type': 'PropertyValue', name: t('data.farm'), value: d.coffee.farm },
            d.coffee.variety && { '@type': 'PropertyValue', name: t('data.variety'), value: d.coffee.variety },
            d.coffee.process && { '@type': 'PropertyValue', name: t('data.process'), value: processLabel(locale, d.coffee.process) },
          ].filter(Boolean),
        }
      : {}),
  },
  author: { '@type': 'Person', name: 'Sabri', url: authorUrl },
  publisher: { '@type': 'Organization', name: 'Cuppindog', url: 'https://cuppindog.com/' },
  datePublished: d.date.toISOString().slice(0, 10),
  reviewRating: {
    '@type': 'Rating',
    ratingValue: d.rating.overall,
    bestRating: 100,
    worstRating: 0,
  },
  name: d.title,
  reviewBody: d.summary,
  url: pageURL,
};

const subRatings = [
  [t('rating.aroma'), d.rating.aroma],
  [t('rating.acidity'), d.rating.acidity],
  [t('rating.body'), d.rating.body],
  [t('rating.sweetness'), d.rating.sweetness],
  [t('rating.aftertaste'), d.rating.aftertaste],
].filter(([, v]) => typeof v === 'number') as [string, number][];
---

<BaseLayout
  title={`${d.title} — ${t('site.name')}`}
  description={d.seoDescription ?? d.summary}
  ogImage={`/og/${entry.id}.jpg`}
  ogType="article"
  locale={locale}
  altUrl={altUrl}
>
  <KenarCakil />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(reviewLd)} is:inline />

  <article>
    <header class="py-8 md:py-16">
      {/* künye satırı: bölüm başlıklarından farklı rol → harf aralığı yok */}
      <p class="font-sans text-xs text-[var(--color-ink-soft)]">
        <span class="text-[var(--color-ink)]">{t('site.author')}</span>
        {' · '}{formatDate(locale, d.date)} · {d.coffee.roaster}
      </p>
      <h1 class="mt-4 font-serif text-3xl sm:text-4xl md:text-6xl leading-[1.1] max-w-2xl [overflow-wrap:anywhere]">
        {d.title}
      </h1>
      <p class="mt-5 font-serif text-base sm:text-lg md:text-xl text-[var(--color-ink-soft)] max-w-2xl leading-relaxed italic">
        {d.summary}
      </p>
    </header>

    {/* Ölçüm paneli başlığın hemen altında: sayfanın ilk "olay"ı bu. */}
    <DataStrip coffee={d.coffee} brew={d.brew} overall={d.rating.overall} locale={locale} />

    {d.coverImage && (
      <figure class="mt-10">
        {/* Tek oran: kapak yüksekliği önceden yazıdan yazıya 996-1329px
            arasında değişiyor, okuyucu gövde metnine her seferinde farklı
            derinlikte iniyordu. Oran 1:1 seçildi çünkü kapakların çoğu zaten
            1024x1024; 16:10 denendi ve fazla agresifti (Peru kapağında poşet
            etiketi, Çekya kapağında poşetin altı kesiliyordu). Kare, dikey
            olan azınlığı da standart 4:5 -> 1:1 kırpımıyla bırakıyor. */}
        <Image
          src={d.coverImage}
          alt={d.title}
          widths={[480, 768, 1200, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          class="w-full aspect-square object-cover"
        />
        <figcaption class="mt-3 font-sans text-xs text-[var(--color-ink-soft)]">
          {[d.coffee.roaster, d.coffee.origin].filter(Boolean).join(' · ')}
        </figcaption>
      </figure>
    )}

    {/* Gövde sola dayalı; sağdaki sütun ikinci okuma katmanı (ölçüm/nota).
        Önceden gövde ortalanmış, başlık sola dayalıydı — göz her seferinde
        108px zıplıyordu ve sağdaki alan boş kalıyordu. */}
    <div class="py-12 grid lg:grid-cols-[minmax(0,42rem)_1fr] gap-x-12 gap-y-12 items-start">
      <div class="prose-editorial font-serif text-lg leading-[1.75] text-[var(--color-ink)]">
        <Content />
      </div>

      {(subRatings.length > 0 || d.rating.flavorNotes.length > 0) && (
        <aside class="lg:sticky lg:top-[3.25rem] xl:top-8 space-y-10 max-w-sm lg:max-w-none">
          {subRatings.length > 0 && (
            <div>
              <SectionLabel as="h3">{t('detail.palate')}</SectionLabel>
              {/* dl/dt/dd değil liste: cetvel dekoratif (aria-hidden) olduğu için
                  dt'nin görünür dd'si kalmıyordu (axe definition-list). */}
              <ul class="mt-5 space-y-4 font-sans text-sm list-none m-0 p-0">
                {subRatings.map(([label, value]) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="text-[var(--color-ink-soft)]">{label}</span>
                      <span class="tnum text-[var(--color-ink)]">{value}<span class="text-[var(--color-ink-soft)] text-xs">/10</span></span>
                    </div>
                    {/* cetvel: 10 çentikli ölçek, yükleme çubuğu değil */}
                    <div class="mt-1.5 relative h-2.5" aria-hidden="true">
                      <div class="absolute inset-x-0 bottom-0 h-px bg-[var(--color-line)]"></div>
                      <div class="absolute inset-x-0 bottom-0 flex justify-between">
                        {Array.from({ length: 10 }).map((_, i) => (
                          <span class={`w-px ${i < value ? 'h-2.5 bg-[var(--color-accent)]' : 'h-1 bg-[var(--color-line)]'}`}></span>
                        ))}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {d.rating.flavorNotes.length > 0 && (
            <div>
              <SectionLabel as="h3">{t('detail.flavors')}</SectionLabel>
              <div class="mt-5"><FlavorChips notes={d.rating.flavorNotes} /></div>
            </div>
          )}
        </aside>
      )}
    </div>
  </article>

  <div class="mt-16 pt-8 border-t border-[var(--color-line)]">
    <a href={localizePath(locale, '/tadimlar/')} class="font-sans text-sm uppercase tracking-[0.2em] text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]">
      {t('detail.back')}
    </a>
  </div>
</BaseLayout>

<style is:global>
  .prose-editorial p { margin: 0 0 1.25em; }
  .prose-editorial p:first-of-type::first-letter {
    font-family: var(--font-serif);
    font-size: 4em;
    font-weight: 500;
    float: left;
    line-height: 0.82;
    padding: 0.1em 0.08em 0 0;
    color: var(--color-accent);
  }
  .prose-editorial h2 { font-size: 1.75rem; margin: 2em 0 0.5em; font-weight: 500; }
  .prose-editorial h3 { font-size: 1.3rem; margin: 1.6em 0 0.4em; font-weight: 500; }
  .prose-editorial blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-ink-soft);
    margin: 1.5em 0;
  }
  .prose-editorial em { font-style: italic; }
  .prose-editorial strong { font-weight: 600; }
  /* Gövde içi bağlantı küçük metin sayılır → 4.5:1 gerekiyor.
     accent (3.09:1) kalıyordu, accent-deep 4.51:1 ile geçiyor. */
  .prose-editorial a { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
</style>
