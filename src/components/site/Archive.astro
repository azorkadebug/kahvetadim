---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrewIcon from '../BrewIcon.astro';
import { useTranslations, archiveCount, archiveDescription, type Lang } from '../../i18n/ui';
import { formatDate, tastingLang, tastingSlug, tastingUrl, localizePath, processLabel, methodLabel } from '../../i18n/utils';
import { renkStil } from '../../lib/renkler';

interface Props {
  locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('tadimlar', (e) => tastingLang(e.id) === locale);
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const otherLang: Lang = locale === 'tr' ? 'en' : 'tr';
const altUrl = localizePath(otherLang, '/tadimlar/');
---

<BaseLayout
  title={`${t('archive.title')} — ${t('site.name')}`}
  description={archiveDescription(locale, sorted.length)}
  locale={locale}
  altUrl={altUrl}
>
  {/* Önceden `items-end justify-between` idi: 1440'ta başlık bloğu ile çizim
      arasında 489px boş alan kalıyor, blok kısa olduğu için alta yapışıp
      kickerı 60px aşağı itiyordu — sayfalar arası ritim buradan kayıyordu.
      `items-start` + `flex-1` ile kicker 257'ye, yani diğer sayfalarla aynı
      yüksekliğe geliyor; çizim `self-end` ile alt hizasını koruyor. */}
  <section class="py-8 md:py-16 border-b border-[var(--color-line)] flex items-start justify-between gap-6">
    <div class="flex-1 min-w-0">
      <p class="etiket">{t('archive.kicker')}</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl">{t('archive.title')}</h1>
      <p class="mt-5 text-[var(--color-ink-soft)] font-serif">{archiveCount(locale, sorted.length)}.</p>
    </div>

    {/* Çakıl demlerken: başlığın yanında, tabloya girmeden. Dar ekranda
        da duruyor ama küçülüyor. */}
    <img
      src="/cakil-demleme.png"
      alt={t('archive.illustrationAlt')}
      width="84"
      height="86"
      class="w-[84px] md:w-[168px] h-auto shrink-0 self-end [image-rendering:pixelated]"
    />
  </section>

  <section class="py-12">
    {sorted.length === 0 ? (
      <p class="font-serif italic text-[var(--color-ink-soft)]">{t('archive.empty')}</p>
    ) : (
      <table class="w-full font-sans text-sm">
        <thead class="text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">
          <tr class="border-b border-[var(--color-line)]">
            <th class="text-left py-3 pr-4 hidden sm:table-cell">{t('archive.th.date')}</th>
            <th class="text-left py-3 pr-4">{t('archive.th.coffee')}</th>
            <th class="text-left py-3 pr-4 hidden sm:table-cell">{t('archive.th.origin')}</th>
            <th class="text-left py-3 pr-4 hidden md:table-cell">{t('archive.th.process')}</th>
            <th class="text-left py-3 pr-4 hidden md:table-cell">{t('archive.th.brew')}</th>
            <th class="text-right py-3">{t('archive.th.score')}</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((entry) => {
            const tdata = entry.data;
            // Satırın tamamı tıklanır: başlık bağlantısının ::after'ı satırı kaplıyor
            // (önceden hover bütün satırı boyuyor ama yalnız başlık tıklanıyordu).
            return (
              <tr style={renkStil(tdata.renk)} class="group relative align-baseline border-b border-[var(--color-line)] hover:bg-[var(--color-bg-soft)]/50">
                <td class="py-4 pr-4 text-[var(--color-ink-soft)] whitespace-nowrap hidden sm:table-cell">{formatDate(locale, tdata.date, { day: 'numeric', month: 'short', year: 'numeric' })}</td>
                <td class="py-4 pr-4 [overflow-wrap:anywhere]">
                  <a href={tastingUrl(locale, tastingSlug(entry.id))} class="baslik-link font-serif text-lg after:absolute after:inset-0">{tdata.title}</a>
                  {/* Dar ekranda tarih sütunu yok (başlığa 128px kalıyordu), tarih buraya iniyor. */}
                  <div class="text-xs text-[var(--color-ink-soft)]">{tdata.coffee.roaster}<span class="sm:hidden"> · {formatDate(locale, tdata.date, { day: 'numeric', month: 'short', year: 'numeric' })}</span></div>
                </td>
                <td class="py-4 pr-4 hidden sm:table-cell">{tdata.coffee.origin}</td>
                <td class="py-4 pr-4 hidden md:table-cell">{processLabel(locale, tdata.coffee.process)}</td>
                <td class="py-4 pr-4 hidden md:table-cell">
                  <span class="inline-flex items-center gap-2">
                    <BrewIcon method={tdata.brew.method.kind} size={18} class="text-[var(--color-accent)]" />
                    {methodLabel(locale, tdata.brew.method)}
                  </span>
                </td>
                <td class="py-4 text-right puan text-lg text-[var(--color-accent-deep)]">{tdata.rating.overall}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </section>
</BaseLayout>
