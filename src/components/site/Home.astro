---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../SectionLabel.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDate, tastingLang, tastingSlug, tastingUrl, localizePath, processLabel } from '../../i18n/utils';
import { renkStil } from '../../lib/renkler';

interface Props {
  locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('tadimlar', (e) => tastingLang(e.id) === locale);
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = sorted.slice(0, 3);
// Dergi mizanpajı: ilk tadım açılış (lead), kalanlar ikincil sütunlarda.
const [lead, ...rest] = latest;

const otherLang: Lang = locale === 'tr' ? 'en' : 'tr';
const altUrl = localizePath(otherLang, '/');
---

<BaseLayout title={t('site.title')} locale={locale} altUrl={altUrl}>
  <h1 class="sr-only">{t('site.title')}</h1>
  {/* KAPAK DÜZENİ: sayfa doğrudan son tadımla açılıyor; başlık bloğu yok,
      bölüm etiketi ikincil kartların üstüne indi. */}
  <section class="pt-2 pb-12">
    {latest.length === 0 ? (
      <p class="font-serif italic text-[var(--color-ink-soft)]">{t('home.empty')}</p>
    ) : (
      <div>
        {/* AÇILIŞ — tam genişlik, sayfanın en büyük görsel anı */}
        {lead && (() => {
          const href = tastingUrl(locale, tastingSlug(lead.id));
          const d = lead.data;
          return (
            <article class="group pb-12 md:pb-16 border-b border-[var(--color-line)]" style={renkStil(d.renk)}>
              {/* Görsel bağlantısı başlığınkinin kopyası: sekme sırasından ve ekran
                  okuyucudan çıkarıldı (kart başına iki durak, başlık üç kez okunuyordu).
                  Oran 4:3 — kapakların çoğu dikey; 16:10 yarısını kesiyordu. */}
              <a href={href} tabindex="-1" aria-hidden="true" class="relative block aspect-square md:aspect-[4/3] bg-[var(--color-bg-soft)] overflow-hidden">
                {d.coverImage && (
                  <Image
                    src={d.coverImage}
                    alt=""
                    widths={[640, 1024, 1440, 1952]}
                    sizes="(min-width: 1024px) 976px, 100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-90"
                  />
                )}
                <div class="absolute top-4 right-4 bg-[var(--color-bg)] px-3 py-2 text-center min-w-[3.5rem]">
                  <div class="font-pixel text-[32px] leading-none text-[var(--color-accent-deep)]">{d.rating.overall}</div>
                  <div class="etiket mt-1">{t('data.score')}</div>
                </div>
              </a>
              {/* İki sütun yalnız lg'de: md'de başlık sütunu 340px'e daralıp 48px
                  puntoyla 6 satıra kırılıyordu. */}
              <div class="mt-6 grid lg:grid-cols-5 gap-x-10 gap-y-4">
                <div class="lg:col-span-3 min-w-0">
                  <p class="font-sans text-xs text-[var(--color-ink-soft)]">
                    {formatDate(locale, d.date)} · {d.coffee.roaster}
                  </p>
                  <h2 class="mt-2 font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.1] [overflow-wrap:anywhere] [text-wrap:balance]">
                    <a href={href} class="baslik-link">{d.title}</a>
                  </h2>
                </div>
                {/* Künye satırı (16px) + h3'ün mt-2'si (8px) kadar aşağı kaydırılıyor ki
                    özetin ilk taban çizgisi başlığınkiyle buluşsun; önceden ikisi
                    aynı üst kenardan başlıyor ama farklı puntoda oldukları için
                    hiçbir yerde hizalanmıyordu. */}
                <div class="lg:col-span-2 min-w-0 lg:mt-6">
                  <p class="text-[var(--color-ink-soft)] leading-relaxed">{d.summary}</p>
                  <p class="mt-4 font-sans text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">
                    {[d.coffee.origin, processLabel(locale, d.coffee.process), d.coffee.variety].filter(Boolean).join(' · ')}
                  </p>
                </div>
              </div>
            </article>
          );
        })()}

        {/* İKİNCİL — yan yana, daha sessiz */}
        {rest.length > 0 && (
          <div class="pt-12 md:pt-16">
            <SectionLabel>{t('home.latest')}</SectionLabel>
          </div>
        )}
        {rest.length > 0 && (
          <div class="grid min-[560px]:grid-cols-2 gap-x-10 gap-y-12 pt-5">
            {rest.map((entry) => {
              const href = tastingUrl(locale, tastingSlug(entry.id));
              const d = entry.data;
              return (
                <article class="group" style={renkStil(d.renk)}>
                  <a href={href} tabindex="-1" aria-hidden="true" class="relative block aspect-square bg-[var(--color-bg-soft)] overflow-hidden">
                    {d.coverImage && (
                      <Image
                        src={d.coverImage}
                        alt=""
                        widths={[320, 480, 640, 960, 1280]}
                        sizes="(min-width: 1024px) 468px, (min-width: 560px) calc(50vw - 3rem), calc(100vw - 2.5rem)"
                        class="w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-90"
                      />
                    )}
                    <div class="absolute top-4 right-4 bg-[var(--color-bg)] px-2.5 py-1.5 text-center">
                      <div class="font-pixel text-[16px] leading-none text-[var(--color-accent-deep)]">{d.rating.overall}</div>
                    </div>
                  </a>
                  <p class="mt-4 font-sans text-xs text-[var(--color-ink-soft)]">
                    {formatDate(locale, d.date)} · {d.coffee.roaster}
                  </p>
                  <h3 class="mt-1.5 font-serif text-xl sm:text-2xl leading-snug [overflow-wrap:anywhere]">
                    <a href={href} class="baslik-link">{d.title}</a>
                  </h3>
                  <p class="mt-3 font-sans text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">
                    {[d.coffee.origin, processLabel(locale, d.coffee.process)].filter(Boolean).join(' · ')}
                  </p>
                </article>
              );
            })}
          </div>
        )}
      </div>
    )}

    {sorted.length > 3 && (
      <div class="mt-16">
        <a href={localizePath(locale, '/tadimlar/')} class="font-sans text-sm uppercase tracking-[0.2em] border-b border-[var(--color-ink)] pb-1 hover:text-[var(--color-accent-deep)] hover:border-[var(--color-accent-deep)] transition-colors">
          {t('home.all')}
        </a>
      </div>
    )}
  </section>
</BaseLayout>
