---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../SectionLabel.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDate, tastingLang, tastingSlug, tastingUrl, localizePath, processLabel } from '../../i18n/utils';

interface Props {
  locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('tadimlar', (e) => tastingLang(e.id) === locale);
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = sorted.slice(0, 3);
// Dergi mizanpajı: ilk tadım açılış (lead), kalanlar ikincil sütunlarda.
const [lead, ...rest] = latest;

const otherLang: Lang = locale === 'tr' ? 'en' : 'tr';
const altUrl = localizePath(otherLang, '/');
---

<BaseLayout title={t('site.title')} locale={locale} altUrl={altUrl}>
  <section class="py-8 md:py-16 border-b border-[var(--color-line)]">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-ink-soft)]">{t('home.kicker')}</p>

    {/* Açılış: maskot konuşuyor. Konuşma balonu piksel diline uysun diye
        köşeler keskin, kuyruk iki kutuyla çiziliyor (SVG yok). */}
    <div class="mt-6 flex items-start gap-4 sm:gap-6">
      <img
        src="/marka-cakil.png"
        alt=""
        width="88"
        height="88"
        class="w-16 sm:w-24 md:w-28 h-auto shrink-0 [image-rendering:pixelated]"
      />

      <div class="relative flex-1 max-w-2xl">
        {/* balon kuyruğu: zemin kutusu çizgiyi siler, üstteki krem kutu içi doldurur */}
        <span class="absolute left-[-9px] top-7 w-4 h-4 rotate-45 border-l-2 border-b-2 border-[var(--color-line)] bg-[var(--color-bg)]"></span>
        <div class="relative border-2 border-[var(--color-line)] bg-[var(--color-bg)] px-5 py-5 sm:px-7 sm:py-6">
          <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl leading-[1.15] break-words">
            {t('home.bark')}
          </h1>
          <p class="mt-3 font-sans text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)]">
            {t('home.barkNote')}
          </p>
        </div>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-lg text-[var(--color-ink-soft)] font-serif">
      {t('home.intro')}
    </p>
  </section>

  <section class="py-12">
    <SectionLabel>{t('home.latest')}</SectionLabel>

    {latest.length === 0 ? (
      <p class="font-serif italic text-[var(--color-ink-soft)]">{t('home.empty')}</p>
    ) : (
      <div class="mt-8">
        {/* AÇILIŞ — tam genişlik, sayfanın en büyük görsel anı */}
        {lead && (() => {
          const href = tastingUrl(locale, tastingSlug(lead.id));
          const d = lead.data;
          return (
            <article class="pb-12 md:pb-16 border-b border-[var(--color-line)]">
              <a href={href} class="relative block aspect-[16/10] bg-[var(--color-bg-soft)] overflow-hidden">
                {d.coverImage && (
                  <Image
                    src={d.coverImage}
                    alt={d.title}
                    widths={[640, 1024, 1440]}
                    sizes="(min-width: 768px) 1024px, 100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full h-full object-cover"
                  />
                )}
                <div class="absolute top-4 right-4 bg-[var(--color-bg)] px-3 py-2 text-center min-w-[3.5rem]">
                  <div class="font-serif tnum text-3xl leading-none text-[var(--color-accent)]">{d.rating.overall}</div>
                  <div class="mt-1 font-sans text-[9px] uppercase tracking-[0.2em] text-[var(--color-ink-soft)]">{t('data.score')}</div>
                </div>
              </a>
              <div class="mt-6 grid md:grid-cols-5 gap-x-10 gap-y-4">
                <div class="md:col-span-3">
                  <p class="font-sans text-xs text-[var(--color-ink-soft)]">
                    {formatDate(locale, d.date)} · {d.coffee.roaster}
                  </p>
                  <h3 class="mt-2 font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.1] break-words">
                    <a href={href} class="hover:text-[var(--color-ink-soft)]">{d.title}</a>
                  </h3>
                </div>
                <div class="md:col-span-2">
                  <p class="text-[var(--color-ink-soft)] leading-relaxed">{d.summary}</p>
                  <p class="mt-4 font-sans text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">
                    {[d.coffee.origin, processLabel(locale, d.coffee.process), d.coffee.variety].filter(Boolean).join(' · ')}
                  </p>
                </div>
              </div>
            </article>
          );
        })()}

        {/* İKİNCİL — yan yana, daha sessiz */}
        {rest.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-x-10 gap-y-12 pt-12 md:pt-16">
            {rest.map((entry) => {
              const href = tastingUrl(locale, tastingSlug(entry.id));
              const d = entry.data;
              return (
                <article>
                  <a href={href} class="relative block aspect-square bg-[var(--color-bg-soft)] overflow-hidden">
                    {d.coverImage && (
                      <Image
                        src={d.coverImage}
                        alt={d.title}
                        widths={[320, 480, 640]}
                        sizes="(min-width: 640px) 45vw, 100vw"
                        class="w-full h-full object-cover"
                      />
                    )}
                    <div class="absolute top-3 right-3 bg-[var(--color-bg)] px-2.5 py-1.5 text-center">
                      <div class="font-serif tnum text-xl leading-none text-[var(--color-accent-deep)]">{d.rating.overall}</div>
                    </div>
                  </a>
                  <p class="mt-4 font-sans text-xs text-[var(--color-ink-soft)]">
                    {formatDate(locale, d.date)} · {d.coffee.roaster}
                  </p>
                  <h3 class="mt-1.5 font-serif text-xl sm:text-2xl leading-snug break-words">
                    <a href={href} class="hover:text-[var(--color-ink-soft)]">{d.title}</a>
                  </h3>
                  <p class="mt-3 font-sans text-xs uppercase tracking-[0.14em] text-[var(--color-ink-soft)]">
                    {[d.coffee.origin, processLabel(locale, d.coffee.process)].filter(Boolean).join(' · ')}
                  </p>
                </article>
              );
            })}
          </div>
        )}
      </div>
    )}

    {sorted.length > 3 && (
      <div class="mt-16">
        <a href={localizePath(locale, '/tadimlar/')} class="font-sans text-sm uppercase tracking-[0.2em] border-b border-[var(--color-ink)] pb-1 hover:text-[var(--color-ink-soft)] hover:border-[var(--color-ink-soft)]">
          {t('home.all')}
        </a>
      </div>
    )}
  </section>
</BaseLayout>
