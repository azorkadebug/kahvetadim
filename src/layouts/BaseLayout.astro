---
import '../styles/global.css';
import { useTranslations, ogLocale, defaultLang, type Lang } from '../i18n/ui';
import { localizePath, routePath } from '../i18n/utils';
import Wordmark from '../components/site/Wordmark.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Yazı sayfalarında "article", diğerlerinde "website". */
  ogType?: 'website' | 'article';
  locale?: Lang;
  /** Diğer dildeki eş sayfanın yolu (yoksa o dilin ana sayfasına düşer). */
  altUrl?: string | null;
}

const {
  title,
  locale = defaultLang,
  description,
  ogImage,
  ogType = 'website',
  altUrl = null,
} = Astro.props;

const t = useTranslations(locale);
const desc = description ?? t('site.description');

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Yazı dışı sayfalar için site şeması (tadımlar kendi Review şemasını taşıyor).
const siteLd = ogType === 'website' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('site.name'),
  url: new URL(localizePath(locale, '/'), Astro.site).toString(),
  inLanguage: locale,
  author: { '@type': 'Person', name: 'Sabri', url: new URL(routePath(locale, 'about'), Astro.site).toString() },
} : null;
// OG görselleri sürümlü yolda (/og/v4/…): 7 gün önbellekte kalıyorlar,
// tasarım değişince scripts/og-ortak.mjs'deki OG_SURUM ile birlikte artır.
const ogImageURL = new URL(ogImage ?? `/og/v4/site-${locale}.png`, Astro.site).toString();

const otherLang: Lang = locale === 'tr' ? 'en' : 'tr';
const otherPath = altUrl ?? localizePath(otherLang, '/');

// hreflang alternates: mevcut dil + (varsa) diğer dil + x-default (EN, artık ana dil)
const trURL = locale === 'tr' ? canonicalURL : altUrl ? new URL(altUrl, Astro.site).toString() : null;
const enURL = locale === 'en' ? canonicalURL : altUrl ? new URL(altUrl, Astro.site).toString() : null;

// Yalnız geliştirmede: html/body'deki `overflow-x: clip` taşmayı gerçek
// ama GÖRÜNMEZ yapıyor — denetimde tek uzun kelimenin arşiv tablosunu 226px
// taşırdığı, puan sütununu tümden yok ettiği ancak kural geçici kaldırılınca
// görülebildi. Bu bekçi aynı ölçümü her yüklemede ve yeniden boyutlandırmada
// yapıp konsola yazar. Üretim çıktısına hiç girmez.
const tasmaBekcisi = `
(() => {
  const bak = () => {
    const d = document.documentElement, b = document.body;
    const eski = [d.style.overflowX, b.style.overflowX];
    d.style.overflowX = b.style.overflowX = 'visible';
    const iw = window.innerWidth, suclu = [];
    document.querySelectorAll('body *').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.width > 0 && (r.right > iw + 0.5 || r.left < -0.5)) suclu.push(el);
    });
    const dw = d.scrollWidth;
    d.style.overflowX = eski[0];
    b.style.overflowX = eski[1];
    if (suclu.length) {
      console.warn('[taşma] ' + iw + 'px genişlikte ' + (dw - iw) + 'px yatay taşma · ' + suclu.length + ' öğe', suclu.slice(0, 8));
    }
  };
  if (document.readyState === 'complete') bak();
  else window.addEventListener('load', bak);
  let z;
  window.addEventListener('resize', () => { clearTimeout(z); z = setTimeout(bak, 250); });
})();
`;

const navArchive = routePath(locale, 'archive');
const navAbout = routePath(locale, 'about');
const homeHref = localizePath(locale, '/');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Tek (açık) tema: tarayıcıların otomatik karartması sayfayı ters çevirmesin. */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f5f0" />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalURL} />

    {trURL && <link rel="alternate" hreflang="tr" href={trURL} />}
    {enURL && <link rel="alternate" hreflang="en" href={enURL} />}
    {enURL && <link rel="alternate" hreflang="x-default" href={enURL} />}

    {/* Font preload YOK: denendi (2026-09-06), 138 KB font render-blocking
        CSS ile bant genişliği paylaşınca detay sayfasında FCP 0,8 → 1,8 s'ye
        çıktı. font-display: swap ile metin önce sistem fontunda çiziliyor. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {siteLd && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} is:inline />}
    <slot name="head" />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-ink)]">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-[var(--color-bg)] focus:px-3 focus:py-2 font-sans text-sm">{t('a11y.skip')}</a>

    {/* Künye ortada: marka üstte, gezinme altında — dergi başlığı düzeni.
        (C düzeni — çizgiye oturan Çakıl — 2026-09-23 denendi, geri alındı.) */}
    <header class="relative z-30 bg-[var(--color-bg)] border-b border-[var(--color-line)] print:hidden">
      <div class="mx-auto max-w-5xl px-5 sm:px-6 py-6 sm:py-8 flex flex-col items-center gap-4">
        <a href={homeHref} class="flex items-center gap-3 font-serif tracking-tight">
          {/* Çakıl: 88px kaynak, 44px çiziliyor — pixelated olmazsa tarayıcı
              yumuşatıp piksel kimliğini bozuyor. */}
          <img
            src="/marka-cakil.png"
            alt=""
            width="44"
            height="44"
            class="w-10 h-10 sm:w-11 sm:h-11 shrink-0 [image-rendering:pixelated]"
          />
          <Wordmark />
          <span class="sr-only">{t('site.name')}</span>
        </a>
        <nav class="font-sans text-xs sm:text-sm uppercase tracking-[0.14em] sm:tracking-widest text-[var(--color-ink-soft)] flex items-center gap-4 sm:gap-6">
          <a href={navArchive} class="py-2 -my-2 hover:text-[var(--color-ink)] transition-colors">{t('nav.archive')}</a>
          <a href={navAbout} class="py-2 -my-2 hover:text-[var(--color-ink)] transition-colors">{t('nav.about')}</a>
          <a
            href={otherPath}
            hreflang={otherLang}
            aria-label={t('a11y.switchLang')}
            class="py-2 -my-2 pl-3 sm:pl-6 border-l border-[var(--color-line)] hover:text-[var(--color-ink)] transition-colors"
          >
            {otherLang.toUpperCase()}
          </a>
        </nav>
      </div>
    </header>

    <main id="icerik" class="mx-auto max-w-5xl px-5 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="mt-8 border-t border-[var(--color-line)]">
      <div class="mx-auto max-w-5xl px-5 sm:px-6 py-6 sm:py-8 font-sans text-xs sm:text-sm text-[var(--color-ink-soft)] flex justify-between items-center gap-4">
        <span>© {new Date().getFullYear()} cuppindog</span>
        <a
          href="https://instagram.com/cuppindog"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('a11y.instagram')}
          class="inline-flex items-center p-3 -m-3 text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <rect x="3" y="3" width="18" height="18" rx="4.5" ry="4.5" />
            <circle cx="12" cy="12" r="3.75" />
            <circle cx="17.25" cy="6.75" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </footer>

    {import.meta.env.DEV && <script is:inline set:html={tasmaBekcisi} />}
  </body>
</html>

<style is:global>
  .font-serif { font-family: var(--font-serif); }
  .font-sans { font-family: var(--font-sans); }
  /* Gezinme: 44px dokunma alanı, hover'da koyulaşır. */
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.3rem;
    transition: color 150ms;
  }
  @media (min-width: 640px) { .nav-link { padding-inline: 0.5rem; } }
  .nav-link:hover { color: var(--color-ink); }
  @media (forced-colors: active) {
    .wordmark rect { fill: CanvasText; }
  }
</style>
